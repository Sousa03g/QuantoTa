{
  "name": "quantota",
  "version": "1.0.0",
  "private": true,
  "description": "QuantoTa? - App de placar ao vivo estilo SofaScore/OneFootball",
  "workspaces": [
    "mobile",
    "api"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace=api",
    "api:build": "npm run build --workspace=api",
