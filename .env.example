# ============================================
# QuantoTa? — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# ----- Database (Neon) -----
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/quantota?sslmode=require

# ----- API-Football (RapidAPI) -----
# Se usar RapidAPI:
FOOTBALL_API_KEY=your-rapidapi-key-here
FOOTBALL_API_HOST=api-football-v1.p.rapidapi.com
# Se usar api-sports.io direto:
# FOOTBALL_API_HOST=v3.football.api-sports.io

# ----- Vercel (for CI/CD) -----
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ----- Expo (for CI/CD) -----
EXPO_TOKEN=

# ----- App -----
API_BASE_URL=https://your-api.vercel.app
